# Версии, из которых собирается APK. Меняете здесь — CI подхватывает сам.
# APP_VERSION — версия самого приложения: сборки из main называются «APP_VERSION-dev.N», релиз — по тегу
# (1.0.4 или v1.0.4). Перед выпуском релиза поднимите APP_VERSION и поставьте тег с тем же номером.
APP_VERSION=1.0.4
PYTHON_VERSION=3.14.8          # официальная сборка CPython для Android (python.org/downloads/android)
WHEEL_API_LEVEL=24             # минимальный API для собираемых колёс (как у PyPI-колёс под Android)
APP_MIN_SDK=33                 # Android 13+
FRX_REPO=Shxdowrate/FRX-Userbot
